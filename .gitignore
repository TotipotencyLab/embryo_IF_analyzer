**.Rproj
**/.DS_Store
**/tmp/

# Data
**/data/
*.lif
*.lifext
*.tif
*.tiff
*.zip
*.html

# Raw Fiji text dumps (outline coordinates / measurement exports).
# NB: macOS sets core.ignorecase=true, so this also matches lowercase
#     "position..." despite the capital P.
*Position[0-9]*.txt

# ...except under fixture/, which holds deliberately version-controlled test
# inputs for the R unit tests.
#
# NB: git will not look inside an excluded directory, so a file cannot be
#     re-included while its parent stays excluded. fixture/*/data/ therefore has
#     to be un-excluded first, and the bulk image data inside it is held back by
#     the per-extension rules above (*.tif, *.lif, *.zip) rather than by **/data/.
!fixture/*/data/
!fixture/**/*.txt

# Machine-local Claude notes (per-machine; not shared)
CLAUDE.local.md

# Personal working notes kept out of the repo on request. note/ is otherwise
# tracked -- fiji_vocabulary.md and wishlist.md are shared reference.
learn_groovy/
note/rig_notes.md
sandbox

# Template by GitHub
# =============================================


# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Default graphics device output. A CLI that opens a device without an explicit
# file, or any plotting done from Rscript, drops this in the working directory —
# so it appears at the repo root, named after nothing, belonging to no run.
Rplots.pdf

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
